# Copy to .env and fill in. Never commit the filled-in file.
#   cp .env.example .env

# ---- database ---------------------------------------------------------------
# Everything the platform stores lives in this one SQLite file. The directory
# is created on first start. Back the service up by stopping it and copying
# this file together with its -wal and -shm sidecars.
DATABASE_PATH=./data/whatsapp.db

# SQLite serialises writes no matter how many connections are open, so a small
# pool is enough; it only needs to keep readers from queueing behind each other.
DATABASE_MAX_CONNS=8
# How long a statement waits for the write lock before giving up.
DATABASE_BUSY_TIMEOUT=10s
DATABASE_AUTO_MIGRATE=true

# ---- application ------------------------------------------------------------
APP_ENV=production

# The port the Go process listens on; the reverse proxy in front of it
# forwards here.
PORT=8086
LOG_LEVEL=info
LOG_FORMAT=json

# Default timezone for the admin panel and new campaigns. Every timestamp is
# stored in UTC; this only controls how times are entered and displayed, so the
# server's own clock zone does not matter.
TIMEZONE=Asia/Almaty

# ---- security ---------------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=

SESSION_TTL=12h
# Must be true in production; requires the panel to be served over HTTPS.
SECURE_COOKIES=true
COOKIE_DOMAIN=

# Comma-separated proxy addresses or CIDRs whose X-Forwarded-For header is
# trusted. Set this to the reverse proxy in front of the app, otherwise every
# request looks like it came from the proxy and login rate limiting keys on that
# single address instead of the real client. Use 127.0.0.1 when the proxy runs
# on this same machine. Leave empty when the app is exposed directly.
TRUSTED_PROXIES=

# Comma-separated origins allowed to call the API from a browser. Leave empty:
# the dashboard is served by this same process, so requests are same-origin and
# no CORS exemption is needed. Only fill this in if a separate front end on
# another domain has to call the API.
ALLOWED_ORIGINS=

LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_WINDOW=15m
LOGIN_LOCK_DURATION=15m

# ---- first administrator ----------------------------------------------------
# Only used when the database has no admin account yet. Remove or rotate the
# password after the first successful sign-in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ---- Green API --------------------------------------------------------------
# From your Green API instance dashboard. Never commit real credentials.
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
# Use the host shown in your instance's dashboard, not the generic one. Green
# API shards instances, and the prefix is the first four digits of the instance
# id: instance 7105xxxxxx is served by 7105.api.greenapi.com. Sending an
# instance's requests to another shard's host will not reach it.
GREEN_API_URL=https://7105.api.greenapi.com
GREEN_API_MEDIA_URL=https://7105.media.greenapi.com

# Inbound messages are pulled from Green API's notification queue, so no
# webhook url and no public hostname are needed. Nothing is configured in the
# Green API console for receiving.
#
# How long Green API holds a poll open waiting for a message. Longer means
# fewer requests and lower latency; it must stay below GREEN_API_TIMEOUT.
GREEN_API_RECEIVE_TIMEOUT=20s
# Pause after an empty queue before polling again.
GREEN_API_POLL_INTERVAL_MS=1000
# Workers applying received notifications (contact creation, enrollment).
GREEN_API_WORKERS=5
GREEN_API_BATCH_SIZE=50

# HTTP client timeout. Must exceed GREEN_API_RECEIVE_TIMEOUT, or every poll is
# aborted before Green API can answer and the provider looks permanently down.
GREEN_API_TIMEOUT=45s
# Minimum spacing between outbound provider calls; protects against 429s.
# Polling does not consume this budget.
GREEN_API_RATE_INTERVAL=1100ms

# ---- media ------------------------------------------------------------------
MEDIA_STORAGE_PATH=./storage/media
MEDIA_MAX_UPLOAD_MB=64

# Absolute base url for media links shown in the panel, e.g.
# https://admin.example.com. Relative paths also work, since the API and the
# dashboard share an origin. Outbound WhatsApp media does not depend on this:
# files are uploaded to Green API directly rather than fetched from a link.
MEDIA_PUBLIC_URL=

# ffmpeg converts uploaded audio into WhatsApp-compatible OGG/Opus voice notes.
# Without it, voice messages require an OGG/Opus upload.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VOICE_BITRATE=32k

# ---- scheduler --------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_WORKERS=4
SCHEDULER_POLL_INTERVAL=5s
SCHEDULER_BATCH_SIZE=25
SCHEDULER_MAX_ATTEMPTS=5
SCHEDULER_RETRY_BASE_DELAY=30s
SCHEDULER_RETRY_MAX_DELAY=30m

# How long a claimed job may stay locked before it is assumed orphaned by a
# crashed worker and returned to the queue.
SCHEDULER_LOCK_TIMEOUT=5m

# Pending jobs older than this are cancelled rather than sent late, so an
# outage does not release a burst of obsolete reminders hours after the event.
SCHEDULER_STALE_JOB_TTL=2h

# ---- integration tests ------------------------------------------------------
# Optional. The suite creates a scratch database in a temp directory by
# default, so nothing needs provisioning:
#   go test -tags=integration ./internal/integration/...
# TEST_DATABASE_PATH=./data/test.db
